# Logs
logs
*.log
npm-debug.log*

# Dependencies
node_modules
.pnp
.pnp.js

# Build output
dist
dist-ssr
*.local

# Environment variables
.env
.env.local
.env.*.local

# Editor directories
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Supabase
supabase/.temp

# Python
__pycache__/
*.pyc
.venv/
venv/

# Geocode cache
geocode_cache.json
geocode_monthly_budget.json

# Test data
data/
# ...but not the app's own bundled static assets (pre-fetched state
# boundary polygons, etc.) -- the "data/" pattern above was meant for a
# scraper test-fixtures directory, not this.
!public/data/
!public/data/**

# Claude Code's own local session/tool state -- never app source.
.claude/

# Scraper run outputs/caches/dumps -- regenerated by each local run, not
# source. scrapers/requirements.txt is the real tracked one; this also
# covers a root-level copy if one gets regenerated there again.
requirements.txt
coverage_summary.json
geocode_failures.json
missing_geocodes.csv
places_cache.json
quick_dump*.json
*.log.err

# One-time reference scrape of ACHC's own site structure -- not app
# source, just a local research artifact for the scrapers.
achcSiteStructure.html

# Supabase CLI auto-generates these empty placeholder migrations when
# pulling remote state that has no corresponding local migration file --
# they're stub bookkeeping, not real schema changes to track.
supabase/migrations/*_remote_baseline.sql
